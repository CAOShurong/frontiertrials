{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caoshurong.github.io/frontiertrials/schemas/candidate.schema.json",
  "title": "FrontierTrials candidate",
  "type": "object",
  "required": ["id", "label", "provider", "model"],
  "properties": {
    "id": {"$ref": "#/$defs/id"},
    "label": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "surface": {"enum": ["web", "desktop", "mobile", "cli-subscription", "manual", "other"]},
    "plan": {"type": "string"},
    "version": {"type": "string"},
    "settings": {"type": "object"},
    "notes": {"type": "string"}
  },
  "additionalProperties": true,
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}}
}
