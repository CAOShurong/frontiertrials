{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caoshurong.github.io/frontiertrials/schemas/rubric.schema.json",
  "title": "FrontierTrials rubric",
  "type": "object",
  "required": ["id", "title", "criteria"],
  "properties": {
    "id": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "minLength": 1},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "question"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "label": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "weight": {"type": "number", "exclusiveMinimum": 0},
          "anchors": {"type": "object"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}}
}
