{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caoshurong.github.io/frontiertrials/schemas/task.schema.json",
  "title": "FrontierTrials task",
  "type": "object",
  "required": ["id", "title", "prompt"],
  "properties": {
    "id": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "minLength": 1},
    "prompt": {"type": "string", "minLength": 1},
    "category": {"enum": ["analysis", "coding", "engineering", "research", "writing", "reasoning", "multilingual", "other"]},
    "system_instruction": {"type": "string"},
    "context": {"type": "string"},
    "reference": {"type": "string"},
    "rubric_id": {"$ref": "#/$defs/id"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  },
  "additionalProperties": true,
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}}
}
